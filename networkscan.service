[Unit]
Description=Network Scanner Flask Application
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/workspace/network_scanner
Environment="PATH=/root/workspace/network_scanner/engine_code/bin"
ExecStart=/root/workspace/network_scanner/engine_code/bin/python /root/workspace/network_scanner/app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target